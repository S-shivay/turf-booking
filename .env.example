# Copy to .env and fill in. Never commit .env.
# Deploying? docs/DEPLOY-VERCEL.md walks through every one of these.

# Postgres (Neon / Supabase POOLED connection string).
# Migrations and seeding need the DIRECT (non-pooled) URL instead — see the
# deploy guide §2.2; a transaction-mode pooler cannot run them.
DATABASE_URL=
# Connections per server instance (default 10). On serverless keep it small: 5.
DB_POOL_MAX=

# Auth.js — generate with: npx auth secret. Fresh value for production.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed outside Vercel (e.g. http://localhost:3000)
AUTH_URL=

# Razorpay. KEY_ID and NEXT_PUBLIC_RAZORPAY_KEY_ID must be the SAME key —
# the server creates the order with one and the browser opens checkout with
# the other. WEBHOOK_SECRET is a string you choose, not the key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend. Leave RESEND_API_KEY empty to log emails instead of sending them.
RESEND_API_KEY=
# Must be an address on a domain verified at resend.com/domains.
# Until a domain is verified, Resend only accepts the shared sender
# "onboarding@resend.dev" AND only delivers to the Resend account's own
# address — every other recipient comes back 403 validation_error.
EMAIL_FROM="Turf Booking <bookings@yourdomain.in>"

# Comma-separated Google emails that get the OWNER role on sign-in.
# While testing without a verified domain, keep this to the Resend
# account's own address or the owner mails will not be delivered.
OWNER_EMAILS=you@gmail.com,partner@gmail.com

# Shared secret for /api/cron/expire-holds (Vercel sends it as Bearer)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Public site config. All of these are inlined into the browser bundle AT
# BUILD TIME — changing one on the host does nothing until you redeploy.
# Unset, the city/area ones render literally as [CITY] / [AREA] on the page.

# No trailing slash. Used by sitemap, robots, OG image and every absolute link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURF_CITY=
NEXT_PUBLIC_TURF_AREA=
NEXT_PUBLIC_TURF_STATE=
# Country code, digits only, e.g. 919876543210. Falls back to the turf phone.
NEXT_PUBLIC_WHATSAPP=
# Optional logo in /public, e.g. /logo.png. A placeholder mark shows until then.
NEXT_PUBLIC_LOGO_SRC=
# Only if the turf trades under a registered company. Empty otherwise — the
# terms then name the turf itself as the contracting party, which is correct.
# Never invent one.
NEXT_PUBLIC_LEGAL_NAME=
